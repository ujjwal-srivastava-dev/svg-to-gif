{
  "name": "svg-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local SVG to transparent animated GIF converter, powered by Node.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:worker && next dev --webpack --hostname 0.0.0.0",
    "build": "npm run build:worker && next build --webpack",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "next start --hostname 0.0.0.0",
    "convert": "node --import tsx scripts/convert.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:worker && node --import tsx --test --test-concurrency=1 scripts/verify.test.ts",
    "test:build": "node --import tsx scripts/check-build.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "sharp": "0.34.5",
    "@img/colour": "1.1.0",
    "next": "16.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "^8.5.6",
    "typescript": "5.9.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
